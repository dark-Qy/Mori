# Server-side narration gateway only. Never embed these values in an Apple app.
AI_BASE_URL=https://api-gateway.openagents.org/v1
AI_API_KEY=replace_with_a_new_server_side_key
AI_MODEL=deepseek-4-flash
AI_REQUEST_TIMEOUT_SECONDS=15
AI_MAX_RESPONSE_TOKENS=300

# Development defaults. Do not log health payloads or prompts in production.
APP_ENV=development
LOG_LEVEL=info
LOG_REQUEST_BODIES=false
