limit_req_zone $binary_remote_addr zone=social_gateway_health:10m rate=2r/s;
limit_req_zone $binary_remote_addr zone=social_gateway_join:10m rate=4r/s;
limit_req_zone $binary_remote_addr zone=social_gateway_api:10m rate=40r/s;

server {
    listen 80;
    listen [::]:80;
    server_name __SOCIAL_GATEWAY_DOMAIN__;

    client_max_body_size 20k;
    access_log off;
    limit_req_status 429;

    location = /healthz {
        limit_req zone=social_gateway_health burst=5 nodelay;
        proxy_pass http://127.0.0.1:8788;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /v1/sessions {
        limit_req zone=social_gateway_join burst=4 nodelay;
        proxy_pass http://127.0.0.1:8788;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /v1/maintenance/cleanup {
        return 404;
    }

    location ^~ /v1/ {
        limit_req zone=social_gateway_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:8788;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /openapi.json {
        return 404;
    }

    location / {
        return 404;
    }
}
