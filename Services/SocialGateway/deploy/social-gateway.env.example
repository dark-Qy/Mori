# Single-instance integration environment.
#
# Keep this process to one worker. The rendezvous store is process-local.
SOCIAL_WAITING_TTL_SECONDS=60
SOCIAL_ENCOUNTER_TTL_SECONDS=180
SOCIAL_CANDIDATE_TTL_SECONDS=12
SOCIAL_TOMBSTONE_TTL_SECONDS=60
SOCIAL_PROXIMITY_WINDOW_SECONDS=5.0
SOCIAL_CLEANUP_INTERVAL_SECONDS=1.0
SOCIAL_MAX_REQUEST_BYTES=16384
SOCIAL_MAX_ACTIVE_PARTICIPANTS=500
