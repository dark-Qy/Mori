[Unit]
Description=Watch Companion Social Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=social-gateway
Group=social-gateway
# Keep the interpreter away from legacy source checkouts under the install root.
# Otherwise Python can shadow the wheel with /opt/.../social_gateway.
WorkingDirectory=/opt/watch-companion-social-gateway/runtime
EnvironmentFile=/etc/watch-companion/social-gateway.env
ExecStart=/opt/watch-companion-social-gateway/venv/bin/python -m social_gateway
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

# The service only needs its virtual environment and in-memory state.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
