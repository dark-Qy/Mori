# Include this file inside the existing social.bsti.online server block.
# It adds an /ai/ namespace without changing the existing /healthz or /v1/
# SocialGateway routes.
location = /ai/healthz {
    limit_req zone=narration_gateway_health burst=5 nodelay;
    proxy_pass http://127.0.0.1:8790/healthz;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s;
    proxy_send_timeout 5s;
    proxy_read_timeout 5s;
}

location = /ai/v1/weekly-memories/polish {
    client_max_body_size 32k;
    limit_req zone=narration_gateway_api burst=10 nodelay;
    proxy_pass http://127.0.0.1:8790/v1/weekly-memories/polish;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization $http_authorization;
    proxy_connect_timeout 2s;
    proxy_send_timeout 5s;
    proxy_read_timeout 12s;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "no-store" always;
}

location = /ai/v1/chat/reply {
    client_max_body_size 32k;
    limit_req zone=narration_gateway_api burst=10 nodelay;
    proxy_pass http://127.0.0.1:8790/v1/chat/reply;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization $http_authorization;
    proxy_connect_timeout 2s;
    proxy_send_timeout 5s;
    proxy_read_timeout 12s;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "no-store" always;
}

location ^~ /ai/ {
    return 404;
}
