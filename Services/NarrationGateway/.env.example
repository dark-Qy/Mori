# Copy to .env for local development. The repository root ignores .env files.
# Never commit a real credential.
NARRATION_BIND_PORT=8790
NARRATION_UPSTREAM_BASE_URL=https://api.stepfun.com
NARRATION_UPSTREAM_MODEL=step-3.7-flash
NARRATION_UPSTREAM_API_KEY=replace-with-a-local-secret
NARRATION_SPEECH_MODEL=stepaudio-2.5-tts
NARRATION_SPEECH_VOICE=ruanmengnvsheng
NARRATION_SPEECH_INSTRUCTION=像亲近的小伙伴一样自然、温柔地说话，语气有呼吸感，避免夸张表演
# Generate a separate random value of at least 24 visible characters.
# This is the client-to-gateway credential, not the upstream provider key.
NARRATION_GATEWAY_ACCESS_TOKEN=replace-with-a-separate-local-token
NARRATION_UPSTREAM_TIMEOUT_SECONDS=8
NARRATION_MAX_REQUEST_BYTES=32768
NARRATION_MAX_UPSTREAM_RESPONSE_BYTES=16384
NARRATION_MAX_SPEECH_RESPONSE_BYTES=2097152
NARRATION_MAX_CHARACTERS=180
NARRATION_MAX_CHAT_REPLY_CHARACTERS=120
NARRATION_MAX_WEEKLY_TITLE_CHARACTERS=24
NARRATION_MAX_WEEKLY_BODY_CHARACTERS=160
NARRATION_RATE_LIMIT_REQUESTS=30
NARRATION_RATE_LIMIT_WINDOW_SECONDS=60
NARRATION_SPEECH_RATE_LIMIT_REQUESTS=12
NARRATION_MAX_CONCURRENT_SPEECH_REQUESTS=2
