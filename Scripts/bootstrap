#!/bin/bash

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO_ROOT

if [[ -z "${DEVELOPER_DIR:-}" && -d "/Applications/Xcode.app/Contents/Developer" ]]; then
  export DEVELOPER_DIR="/Applications/Xcode.app/Contents/Developer"
fi

for tool in git xcodebuild xcrun swift; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "error: required tool '$tool' is not available." >&2
    exit 1
  fi
done

if ! command -v python3 >/dev/null 2>&1; then
  echo "error: required tool 'python3' is not available." >&2
  exit 1
fi

echo "Repository: $REPO_ROOT"
echo "Developer directory: ${DEVELOPER_DIR:-$(xcode-select -p)}"
xcodebuild -version
swift --version

package_manifests=()
while IFS= read -r manifest; do
  package_manifests+=("$manifest")
done < <(find "$REPO_ROOT/Packages" -name Package.swift -type f -print 2>/dev/null | sort)
if [[ ${#package_manifests[@]} -gt 0 ]]; then
  for package_manifest in "${package_manifests[@]}"; do
    package_directory="$(dirname "$package_manifest")"
    echo "Resolving Swift package: ${package_directory#$REPO_ROOT/}"
    swift package --package-path "$package_directory" resolve
  done
else
  echo "notice: no Swift package manifest exists yet; package resolution was skipped."
fi

project_path="$(find "$REPO_ROOT/Apps" -name '*.xcodeproj' -type d -exec test -f '{}/project.pbxproj' \; -print 2>/dev/null | sort | head -n 1 || true)"
if [[ -n "$project_path" ]]; then
  echo "Discovered Xcode project: ${project_path#$REPO_ROOT/}"
  xcodebuild -list -project "$project_path"
else
  echo "notice: no complete Xcode project exists yet; Apple target discovery was skipped."
fi

narration_service="$REPO_ROOT/Services/NarrationGateway"
if [[ -f "$narration_service/pyproject.toml" ]]; then
  narration_venv="$REPO_ROOT/.artifacts/narration-gateway-venv"
  if [[ ! -x "$narration_venv/bin/python" ]]; then
    echo "Creating Narration Gateway test environment."
    python3 -m venv "$narration_venv"
  fi
  echo "Installing Narration Gateway and its test tools."
  "$narration_venv/bin/python" -m pip install --disable-pip-version-check --upgrade pip
  "$narration_venv/bin/python" -m pip install --disable-pip-version-check -e "$narration_service[test]"
fi

echo "Bootstrap checks completed."
