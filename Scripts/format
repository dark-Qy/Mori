#!/bin/bash

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO_ROOT

if [[ -z "${DEVELOPER_DIR:-}" && -d "/Applications/Xcode.app/Contents/Developer" ]]; then
  export DEVELOPER_DIR="/Applications/Xcode.app/Contents/Developer"
fi

if ! xcrun --find swift-format >/dev/null 2>&1; then
  echo "error: swift-format was not found in the selected Xcode toolchain." >&2
  exit 1
fi

source_roots=()
for candidate in "$REPO_ROOT/Apps" "$REPO_ROOT/Packages" "$REPO_ROOT/Services"; do
  if [[ -d "$candidate" ]] && find "$candidate" -name '*.swift' -type f -print -quit | grep -q .; then
    source_roots+=("$candidate")
  fi
done

if [[ ${#source_roots[@]} -eq 0 ]]; then
  echo "notice: no Swift sources exist yet; formatting was skipped."
else
  echo "Formatting Swift sources with the selected Xcode toolchain."
  xcrun swift-format format --in-place --recursive --parallel "${source_roots[@]}"
fi

narration_service="$REPO_ROOT/Services/NarrationGateway"
narration_venv="$REPO_ROOT/.artifacts/narration-gateway-venv"
if [[ -f "$narration_service/pyproject.toml" ]]; then
  if [[ ! -x "$narration_venv/bin/ruff" ]]; then
    echo "error: Narration Gateway tools are missing; run Scripts/bootstrap first." >&2
    exit 1
  fi
  echo "Formatting Narration Gateway sources."
  "$narration_venv/bin/ruff" format "$narration_service"
fi

social_service="$REPO_ROOT/Services/SocialGateway"
social_venv="$REPO_ROOT/.artifacts/social-gateway-venv"
if [[ -f "$social_service/pyproject.toml" ]]; then
  if [[ ! -x "$social_venv/bin/ruff" ]]; then
    echo "error: Social Gateway tools are missing; run Scripts/bootstrap first." >&2
    exit 1
  fi
  echo "Formatting Social Gateway sources."
  "$social_venv/bin/ruff" format "$social_service"
fi
